# Copy this file to .env and fill in your real credentials.
# NEVER put real secret keys in this .env.example file.

STRIPE_SECRET_KEY=your_stripe_secret_key_here
PORT=4242

# Packeta
PACKETA_API_PASSWORD=your_packeta_api_password_here
PACKETA_SENDER_LABEL=your_packeta_sender_label_here

# GLS
GLS_API_USERNAME=your_gls_username_here
GLS_API_PASSWORD=your_gls_password_here
GLS_CLIENT_ID=your_gls_client_id_here

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here