# Copy this file to .env in the project root and fill in your real Stripe
# PUBLISHABLE key (starts with pk_test_ or pk_live_) from
# https://dashboard.stripe.com/apikeys.
#
# Note: this project is built with Vite, not Next.js — Vite only exposes
# env vars prefixed with VITE_ to frontend code, so use VITE_ here (the
# common NEXT_PUBLIC_ prefix from Next.js projects would silently not work).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY

# The SECRET key must never be used in frontend code or committed here.
# It belongs on the backend only — see server/.env.example.
# STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SECRET_KEY   (set this in /server/.env instead)

# Optional — enables the REAL Packeta "Widget v6" pickup-point picker
# (Packeta's own hosted UI, not ours) instead of the placeholder point list.
# Get a free API key by registering at https://client.packeta.com/ , then
# under "User support" request your API password/key (no business contract
# needed just for the widget — that's only required for label/shipment
# creation, see server/.env.example). Safe to expose in frontend code.
# Leave empty to keep using the placeholder pickup points during development.
VITE_PACKETA_API_KEY=

# Powers two things on the entry gate (src/components/ui/GateOverlay.jsx):
#  1. The email signup form writes each submitted email into a "signups"
#     table in your Supabase project.
#  2. The "Log in" link lets only you (the site owner) actually unlock the
#     site, via Supabase Auth.
# Get both values from your Supabase project: Settings -> API.
# Safe to expose in frontend code (see src/config/supabase.js for why).
# See the project setup notes for the exact table + policy SQL to run, and
# how to create yourself a login user, before this works.

VITE_SUPABASE_URL=https://bzfrhkrpwjbtyzmnarmu.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_W-iksCWjscF0hksCz-0M-g_2jvJXHB4